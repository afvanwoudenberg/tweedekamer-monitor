      van ,
    
      
      van_ruw ,
    
      
      van_precisie ,
    
      
      tot_en_met ,
    
      
      tot_en_met_ruw ,
    
      
      tot_en_met_precisie ,
    
      
      betaald_door ,
    
      
      gewicht ,
    
      
      gewijzigd_op ,
    
      
      api_gewijzigd_op 
    
  )
