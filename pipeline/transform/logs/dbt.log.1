DESCRIBE (select * from (
        

WITH links AS (
    SELECT
        _dlt_parent_id,
        MAX(CASE WHEN rel = 'enclosure' THEN href END) AS logo_url
    FROM "tweedekamer"."bronze"."fractie__atom_links"
    GROUP BY 1
),

latest AS (
    SELECT
        f.id,
        f.nummer,
        f.afkorting,
        f.naam_nl,
        f.naam_en,
        CAST(f.aantal_zetels AS INTEGER) AS aantal_zetels,
        CAST(f.aantal_stemmen AS INTEGER) AS aantal_stemmen,
        
struct_pack(
    datum := CASE
        WHEN regexp_matches(f.datum_actief, '^\d{4}-\d{2}-\d{2}$')
            THEN CAST(f.datum_actief AS DATE)
        WHEN regexp_matches(f.datum_actief, '^\d{4}-\d{2}$')
            THEN CAST(f.datum_actief || '-01' AS DATE)
        WHEN regexp_matches(f.datum_actief, '^\d{4}-W\d{2}-\d$')
            THEN 
(
    DATE (substr(f.datum_actief, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(f.datum_actief, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(f.datum_actief, 7, 2) AS INTEGER) - 1) * 7
        - ((CAST(substr(f.datum_actief, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(f.datum_actief, '^\d{4}-W\d{2}$')
