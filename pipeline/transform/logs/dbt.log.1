        verwijderd,
        bijgewerkt AS gewijzigd_op,
        feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."document_publicatie_metadata"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT
        latest.id,
        latest.document_versie_id,
        latest.identifier,
        latest.document_type,
        latest.url,
        latest.file_name,
        latest.source,
        latest.content_length,
        latest.content_type,
        latest.publicatie_datum,
        latest.gewijzigd_op,
        latest.api_gewijzigd_op
    FROM latest
    INNER JOIN "tweedekamer"."silver"."document_versie" AS parent
        ON latest.document_versie_id = parent.id
    WHERE NOT latest.verwijderd
        
)

SELECT
    id,
    document_versie_id,
    identifier,
    document_type,
    url,
    file_name,
    source,
    content_length,
    content_type,
    publicatie_datum,
    gewijzigd_op,
    api_gewijzigd_op
FROM incoming
    ) as model_subq
    );
  
  
