    from (
        

WITH latest AS (
    SELECT
        id,
        persoon_nevenfunctie__ref AS persoon_nevenfunctie_id,
        CAST(jaar AS INTEGER) AS jaar,
        bedrag_soort,
        bedrag_voorvoegsel,
