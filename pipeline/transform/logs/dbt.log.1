    - CAST(
        (isodow(DATE (substr(f.datum_actief, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(f.datum_actief, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(f.datum_actief, '^\d{4}$')
            THEN CAST(f.datum_actief || '-01-01' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(f.datum_actief, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(f.datum_actief, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(f.datum_actief, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(f.datum_actief, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(f.datum_actief, '^\d{4}$') THEN 'jaar'
        ELSE NULL
    END
)
 AS datum_actief_parsed,
        f.datum_actief AS datum_actief_ruw,
        
struct_pack(
    datum := CASE
        WHEN regexp_matches(f.datum_inactief, '^\d{4}-\d{2}-\d{2}$')
            THEN CAST(f.datum_inactief AS DATE)
        WHEN regexp_matches(f.datum_inactief, '^\d{4}-\d{2}$')
            THEN last_day(CAST(f.datum_inactief || '-01' AS DATE))
        WHEN regexp_matches(f.datum_inactief, '^\d{4}-W\d{2}-\d$')
            THEN 
(
    DATE (substr(f.datum_inactief, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(f.datum_inactief, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(f.datum_inactief, 7, 2) AS INTEGER) - 1) * 7
        - ((CAST(substr(f.datum_inactief, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(f.datum_inactief, '^\d{4}-W\d{2}$')
            THEN 
(
    DATE (substr(f.datum_inactief, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(f.datum_inactief, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(f.datum_inactief, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)
 + INTERVAL '6 days'
        WHEN regexp_matches(f.datum_inactief, '^\d{4}$')
            THEN CAST(f.datum_inactief || '-12-31' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(f.datum_inactief, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(f.datum_inactief, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(f.datum_inactief, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
