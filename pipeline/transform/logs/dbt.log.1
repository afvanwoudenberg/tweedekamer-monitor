WITH latest AS (
    SELECT
        id,
        persoon_nevenfunctie__ref AS persoon_nevenfunctie_id,
        CAST(jaar AS INTEGER) AS jaar,
        bedrag_soort,
        bedrag_voorvoegsel,
        bedrag_valuta,
        CAST(bedrag AS DECIMAL(38, 9)) AS bedrag,
        bedrag_achtervoegsel,
