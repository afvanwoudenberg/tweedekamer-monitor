        (isodow(DATE (substr(p.geboortedatum, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(p.geboortedatum, 7, 2) AS INTEGER) - 1) * 7
        - ((CAST(substr(p.geboortedatum, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(p.geboortedatum, '^\d{4}-W\d{2}$')
            THEN 
(
    DATE (substr(p.geboortedatum, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(p.geboortedatum, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(p.geboortedatum, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(p.geboortedatum, '^\d{4}$')
            THEN CAST(p.geboortedatum || '-01-01' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(p.geboortedatum, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(p.geboortedatum, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(p.geboortedatum, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(p.geboortedatum, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(p.geboortedatum, '^\d{4}$') THEN 'jaar'
        ELSE NULL
    END
)
 AS geboortedatum_parsed,
        p.geboortedatum AS geboortedatum_ruw,
        p.geboorteplaats,
        p.geboorteland,
        
struct_pack(
    datum := CASE
        WHEN regexp_matches(p.overlijdensdatum, '^\d{4}-\d{2}-\d{2}$')
            THEN CAST(p.overlijdensdatum AS DATE)
        WHEN regexp_matches(p.overlijdensdatum, '^\d{4}-\d{2}$')
            THEN CAST(p.overlijdensdatum || '-01' AS DATE)
        WHEN regexp_matches(p.overlijdensdatum, '^\d{4}-W\d{2}-\d$')
            THEN 
(
    DATE (substr(p.overlijdensdatum, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(p.overlijdensdatum, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(p.overlijdensdatum, 7, 2) AS INTEGER) - 1) * 7
        - ((CAST(substr(p.overlijdensdatum, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(p.overlijdensdatum, '^\d{4}-W\d{2}$')
            THEN 
(
    DATE (substr(p.overlijdensdatum, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(p.overlijdensdatum, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(p.overlijdensdatum, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(p.overlijdensdatum, '^\d{4}$')
            THEN CAST(p.overlijdensdatum || '-01-01' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(p.overlijdensdatum, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(p.overlijdensdatum, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(p.overlijdensdatum, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(p.overlijdensdatum, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(p.overlijdensdatum, '^\d{4}$') THEN 'jaar'
        ELSE NULL
    END
)
 AS overlijdensdatum_parsed,
        p.overlijdensdatum AS overlijdensdatum_ruw,
        p.overlijdensplaats,
        p.woonplaats,
        p.land,
        p.fractielabel,
        l.portret_url,
        p.content_type,
        CAST(p.content_length AS INTEGER) AS content_length,
        p.verwijderd,
        p.bijgewerkt AS gewijzigd_op,
        p.feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."persoon" AS p
    LEFT JOIN links AS l ON p._dlt_id = l._dlt_parent_id
),

incoming AS (
    SELECT * EXCLUDE (geboortedatum_parsed, overlijdensdatum_parsed),
        geboortedatum_parsed.datum AS geboortedatum,
        geboortedatum_parsed.precisie AS geboortedatum_precisie,
        overlijdensdatum_parsed.datum AS overlijdensdatum,
        overlijdensdatum_parsed.precisie AS overlijdensdatum_precisie
    FROM (
        SELECT *
        FROM renamed
        QUALIFY ROW_NUMBER() OVER (
            PARTITION BY id
            ORDER BY gewijzigd_op DESC, api_gewijzigd_op DESC
        ) = 1
    ) AS latest
    WHERE NOT verwijderd
        
        AND api_gewijzigd_op > (SELECT MAX(api_gewijzigd_op) FROM "tweedekamer"."silver"."persoon")
        
)

SELECT
    id,
    nummer,
    titels,
    initialen,
    tussenvoegsel,
    achternaam,
    voornamen,
    roepnaam,
    geslacht,
    functie,
    geboortedatum,
    geboortedatum_ruw,
    geboortedatum_precisie,
    geboorteplaats,
    geboorteland,
    overlijdensdatum,
    overlijdensdatum_ruw,
    overlijdensdatum_precisie,
    overlijdensplaats,
    woonplaats,
    land,
    fractielabel,
    portret_url,
    content_type,
    content_length,
    gewijzigd_op,
    api_gewijzigd_op
FROM incoming
-- Deduplicate to the most recent version per person within this batch
QUALIFY ROW_NUMBER() OVER (PARTITION BY id ORDER BY gewijzigd_op DESC, api_gewijzigd_op DESC) = 1
    );
    
  
  
