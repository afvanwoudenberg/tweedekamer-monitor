        latest.frequentie,
        latest.frequentie_beschrijving,
        latest.opmerking,
        latest.gewijzigd_op,
        latest.api_gewijzigd_op
    FROM latest
    INNER JOIN "tweedekamer"."silver"."persoon_nevenfunctie" AS parent
        ON latest.persoon_nevenfunctie_id = parent.id
    WHERE NOT latest.verwijderd
        
)

