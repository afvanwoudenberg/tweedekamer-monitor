    ) = 1
),

incoming AS (
    SELECT
        latest.id,
        latest.persoon_nevenfunctie_id,
        latest.jaar,
        latest.bedrag_soort,
        latest.bedrag_voorvoegsel,
        latest.bedrag_valuta,
