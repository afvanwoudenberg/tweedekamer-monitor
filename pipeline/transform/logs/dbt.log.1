DESCRIBE (select * from (
        

WITH latest AS (
    SELECT
        id,
        persoon__ref AS persoon_id,
        omschrijving,
        
struct_pack(
    datum := CASE
        WHEN regexp_matches(datum, '^\d{4}-\d{2}-\d{2}$')
            THEN CAST(datum AS DATE)
        WHEN regexp_matches(datum, '^\d{4}-\d{2}$')
            THEN CAST(datum || '-01' AS DATE)
        WHEN regexp_matches(datum, '^\d{4}-W\d{2}-\d$')
            THEN 
(
    DATE (substr(datum, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(datum, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(datum, 7, 2) AS INTEGER) - 1) * 7
        - ((CAST(substr(datum, 11, 1) AS INTEGER)) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(datum, '^\d{4}-W\d{2}$')
            THEN 
(
    DATE (substr(datum, 1, 4) || '-01-04')
    - CAST(
        (isodow(DATE (substr(datum, 1, 4) || '-01-04')) - 1)
        - (CAST(substr(datum, 7, 2) AS INTEGER) - 1) * 7
        - ((1) - 1)
        AS INTEGER
    )
)

        WHEN regexp_matches(datum, '^\d{4}$')
            THEN CAST(datum || '-01-01' AS DATE)
        ELSE NULL
    END,
    precisie := CASE
        WHEN regexp_matches(datum, '^\d{4}-\d{2}-\d{2}$') THEN 'dag'
        WHEN regexp_matches(datum, '^\d{4}-\d{2}$') THEN 'maand'
        WHEN regexp_matches(datum, '^\d{4}-W\d{2}-\d$') THEN 'week_dag'
        WHEN regexp_matches(datum, '^\d{4}-W\d{2}$') THEN 'week'
        WHEN regexp_matches(datum, '^\d{4}$') THEN 'jaar'
        ELSE NULL
    END
)
 AS datum_parsed,
        datum AS datum_ruw,
        CAST(gewicht AS INTEGER) AS gewicht,
        verwijderd,
        bijgewerkt AS gewijzigd_op,
        feed_updated AS api_gewijzigd_op
    FROM "tweedekamer"."bronze"."persoon_geschenk"
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY id
        ORDER BY bijgewerkt DESC, feed_updated DESC, _dlt_id DESC
    ) = 1
),

incoming AS (
    SELECT
        id,
        persoon_id,
        omschrijving,
        datum_parsed.datum AS datum,
        datum_ruw,
        datum_parsed.precisie AS datum_precisie,
        gewicht,
        gewijzigd_op,
        api_gewijzigd_op
    FROM latest
    WHERE NOT verwijderd
        
        AND api_gewijzigd_op > (SELECT MAX(api_gewijzigd_op) FROM "tweedekamer"."silver"."persoon_geschenk")
        
)

SELECT
    id,
    persoon_id,
    omschrijving,
    datum,
    datum_ruw,
    datum_precisie,
    gewicht,
    gewijzigd_op,
    api_gewijzigd_op
FROM incoming
    ) as __dbt_sbq
    where false
    limit 0
)
